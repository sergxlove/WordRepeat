<Window x:Class="WordRepeat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WordRepeat"
        xmlns:services="clr-namespace:WordRepeat.Services"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="WordRepeat" 
        Height="550" 
        Width="950"
        MinHeight="400" 
        MinWidth="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="#FF1A1A1A"/>
            <Setter Property="BorderBrush" Value="#FF444444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2A2A2A"/>
                                <Setter Property="BorderBrush" Value="#FF555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF444444"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Duration="0:0:0.1" 
                                                             To="1.1" 
                                                             Storyboard.TargetProperty="RenderTransform.ScaleX"/>
                                            <DoubleAnimation Duration="0:0:0.1" 
                                                             To="1.1" 
                                                             Storyboard.TargetProperty="RenderTransform.ScaleY"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Duration="0:0:0.1" 
                                                             To="1" 
                                                             Storyboard.TargetProperty="RenderTransform.ScaleX"/>
                                            <DoubleAnimation Duration="0:0:0.1" 
                                                             To="1" 
                                                             Storyboard.TargetProperty="RenderTransform.ScaleY"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF666666"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="WindowOpenStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                             From="0" 
                             To="1" 
                             Duration="0:0:0.3" 
                             AccelerationRatio="0.3"
                             DecelerationRatio="0.7"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX" 
                             From="0.95" 
                             To="1" 
                             Duration="0:0:0.3"
                             AccelerationRatio="0.3"
                             DecelerationRatio="0.7"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY" 
                             From="0.95" 
                             To="1" 
                             Duration="0:0:0.3"
                             AccelerationRatio="0.3"
                             DecelerationRatio="0.7"/>
        </Storyboard>

        <Storyboard x:Key="WindowCloseStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                             From="1" 
                             To="0" 
                             Duration="0:0:0.2"
                             AccelerationRatio="0.7"
                             DecelerationRatio="0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX" 
                             From="1" 
                             To="0.95" 
                             Duration="0:0:0.2"
                             AccelerationRatio="0.7"
                             DecelerationRatio="0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY" 
                             From="1" 
                             To="0.95" 
                             Duration="0:0:0.2"
                             AccelerationRatio="0.7"
                             DecelerationRatio="0.3"/>
        </Storyboard>
    </Window.Resources>

    <Window.RenderTransform>
        <TransformGroup>
            <ScaleTransform/>
        </TransformGroup>
    </Window.RenderTransform>

    <Border x:Name="MainBorder" 
            Background="#FF292727" 
            CornerRadius="10"
            BorderBrush="#FF444444"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" 
                    Background="#FF1A1A1A" 
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal" 
                                Margin="15,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="WORDREPEAT" 
                                   Foreground="White" 
                                   FontWeight="Bold"
                                   FontSize="22"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" 
                            VerticalAlignment="Center"
                            Margin="0,5,15,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="MinimizeButton" 
                                    Style="{StaticResource WindowControlButtonStyle}"
                                    Content="&#xE921;"
                                    Click="MinimizeButton_Click"
                                    ToolTip="Свернуть"
                                    Margin="0,0,2,0">
                                <Button.RenderTransform>
                                    <ScaleTransform/>
                                </Button.RenderTransform>
                            </Button>

                            <Button x:Name="MaximizeButton" 
                                    Style="{StaticResource WindowControlButtonStyle}"
                                    Content="&#xE922;"
                                    Click="MaximizeButton_Click"
                                    ToolTip="Развернуть"
                                    Margin="0,0,2,0">
                                <Button.RenderTransform>
                                    <ScaleTransform/>
                                </Button.RenderTransform>
                            </Button>

                            <Button x:Name="CloseButton" 
                                    Style="{StaticResource CloseButtonStyle}"
                                    Content="&#xE8BB;"
                                    Click="CloseButton_Click"
                                    ToolTip="Закрыть"
                                    Margin="0,0,0,0">
                                <Button.RenderTransform>
                                    <ScaleTransform/>
                                </Button.RenderTransform>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="1">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="#FF1A1A1A"/>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Content="НАВИГАЦИЯ" 
                           Grid.Row="1"
                           Foreground="#FF666677"
                           Margin="10,20,10,5"/>

                    <StackPanel Grid.Row="2" 
                                Margin="10,0,10,10"
                                VerticalAlignment="Top">
                        <Button x:Name="MainButton" 
                                Content="🏠 Главная" 
                                Style="{StaticResource NavButtonStyle}"
                                Click="MainButtonClick"/>

                        <Button x:Name="WordButton" 
                                Content="📚 Словарь" 
                                Style="{StaticResource NavButtonStyle}"
                                Click="WordButtonClick"/>

                        <Button x:Name="TrainButton" 
                                Content="🔄 Повторение" 
                                Style="{StaticResource NavButtonStyle}"
                                Click="TrainButtonClick"/>

                        <Button x:Name="NotesButton" 
                                Content="📚 Заметки" 
                                Style="{StaticResource NavButtonStyle}"
                                Click="NotesButtonClick"/>

                        <Button x:Name="HistoryButton" 
                                Content="📅 История" 
                                Style="{StaticResource NavButtonStyle}"
                                Click="HistoryButtonClick"/>

                        <Button x:Name="SettingButton" 
                                Content="⚙️ Настройки" 
                                Style="{StaticResource NavButtonStyle}"
                                Click="SettingButtonClick"/>
                    </StackPanel>

                    <Border Grid.Row="3" 
                            Background="#FF1A1A1A"
                            Margin="10"
                            Padding="10"
                            CornerRadius="5">
                        <TextBlock Text="developer sergxlove, 2026" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Foreground="#FF888888"
                                   FontSize="11"/>
                    </Border>
                </Grid>

                <Border Grid.Column="1" 
                        Margin="10" 
                        BorderBrush="#FF1C1C1C" 
                        BorderThickness="1"
                        Background="Transparent">
                    <ContentControl x:Name="MainContentControl"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                        <Grid>
                            <TextBlock Text="Выберите раздел в навигации" 
                                       Foreground="#FF666677"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ContentControl>
                </Border>

                <Grid Grid.Column="1"
                      x:Name="NotificationContainer"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="20"
                      Width="420"
                      IsHitTestVisible="True"
                      Panel.ZIndex="1000">
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
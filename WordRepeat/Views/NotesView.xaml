<UserControl x:Class="WordRepeat.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="528" d:DesignWidth="703"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="BorderBrush" Value="#FF444444"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#FF4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF45A049"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#FF555555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#FFD32F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFC62828"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalOverlayStyle" TargetType="Border">
            <Setter Property="Background" Value="#80000000"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="ModalWindowStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#FF444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="700"/>
            <Setter Property="MinWidth" Value="600"/>
            <Setter Property="MaxWidth" Value="900"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка создания -->
        <Border Grid.Row="0" 
                Margin="10,10,10,20" 
                Background="#FF1E1E1E" 
                CornerRadius="8"
                BorderBrush="#FF444444"
                BorderThickness="1">

            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📝" 
                                   Foreground="White" 
                                   FontSize="20" 
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Заметки" 
                                       Foreground="White" 
                                       FontSize="20" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="Создавайте, редактируйте и управляйте своими заметками" 
                                       Foreground="#FFAAAAAA" 
                                       FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="➕ Создать заметку"
                        Width="140"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CreateNoteButton_Click"/>
            </Grid>
        </Border>

        <!-- Список заметок -->
        <Border Grid.Row="1" 
                Margin="10,0,10,10" 
                Background="#FF1A1A1A" 
                CornerRadius="8"
                BorderBrush="#FF333333"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" 
                        Background="#FF222222" 
                        CornerRadius="8,8,0,0"
                        BorderBrush="#FF333333"
                        BorderThickness="0,0,0,1">

                    <StackPanel Orientation="Horizontal" 
                                Margin="15,15,15,10">
                        <TextBlock Text="📚" 
                                   Foreground="White" 
                                   FontSize="16" 
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="Мои заметки" 
                                   Foreground="White" 
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="SearchTextBox" 
                                 Width="200"
                                 Height="30"
                                 Background="#FF2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#FF555555"
                                 Padding="10,0"
                                 Margin="20,0,0,0"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchTextBox_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4"/>
                                                    <ScrollViewer x:Name="PART_ContentHost" 
                                                                  Margin="5,0"/>
                                                    <TextBlock Text="Поиск заметок..." 
                                                               Foreground="#FF666666"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button Content="🗘 Обновить" 
                                Width="100" Height="30"
                                Margin="20,0,0,0"
                                Background="#FF2196F3"
                                Foreground="White"
                                BorderThickness="0"
                                Click="RefreshButton_Click"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="NotesDataGrid" 
                          Grid.Row="1"
                          Margin="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          Background="Transparent"
                          Foreground="White"
                          BorderThickness="0"
                          RowBackground="#FF222222"
                          AlternatingRowBackground="#FF1E1E1E"
                          HeadersVisibility="Column"
                          HorizontalGridLinesBrush="#FF333333"
                          VerticalGridLinesBrush="#FF333333"
                          MouseDoubleClick="NotesDataGrid_MouseDoubleClick">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" 
                                            Width="300" 
                                            Binding="{Binding Title}"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Содержание" 
                                            Width="*" 
                                            Binding="{Binding Content}"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFAAAAAA"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,5"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="MaxHeight" Value="60"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Модальное окно для создания/редактирования/просмотра -->
        <Border x:Name="ModalOverlay" 
                Style="{StaticResource ModalOverlayStyle}"
                Grid.RowSpan="2">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Style="{StaticResource ModalWindowStyle}">
                    <Grid Margin="25">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25">
                            <TextBlock x:Name="ModalTitleIcon" Text="➕" 
                                       Foreground="White" 
                                       FontSize="24" 
                                       Margin="0,0,12,0"/>
                            <TextBlock x:Name="ModalTitle" Text="Создание заметки" 
                                       Foreground="White" 
                                       FontSize="20"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,20">
                            <TextBlock Text="Название заметки" 
                                       Foreground="#FFAAAAAA" 
                                       FontSize="14"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="TitleTextBox" 
                                     Height="45" 
                                     Background="#FF333333"
                                     Foreground="White"
                                     BorderBrush="#FF555555"
                                     Padding="12"
                                     FontSize="15"
                                     IsReadOnly="{Binding IsViewMode}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,0,20">
                            <TextBlock Text="Содержание заметки" 
                                       Foreground="#FFAAAAAA" 
                                       FontSize="14"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="ContentTextBox" 
                                     Height="300" 
                                     MinHeight="250"
                                     Background="#FF333333"
                                     Foreground="White"
                                     BorderBrush="#FF555555"
                                     Padding="12"
                                     FontSize="14"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="{Binding IsViewMode}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,0,0,25" Visibility="Collapsed" x:Name="DateUpdatePanel">
                            <TextBlock Text="Дата последнего обновления" 
                                       Foreground="#FFAAAAAA" 
                                       FontSize="13"
                                       Margin="0,0,0,6"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="DateUpdateText" 
                                       Foreground="#FF888888" 
                                       FontSize="13"
                                       Background="#FF333333"
                                       Padding="12,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelModalButton" 
                                    Content="Отмена"
                                    Width="100"
                                    Height="38"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,12,0"
                                    Click="CancelModalButton_Click"/>
                            <Button x:Name="EditFromViewButton" 
                                    Content="Редактировать"
                                    Width="120"
                                    Height="38"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="EditFromViewButton_Click"
                                    Visibility="Collapsed"/>
                            <Button x:Name="DeleteFromViewButton" 
                                    Content="Удалить"
                                    Width="100"
                                    Height="38"
                                    Style="{StaticResource DeleteButtonStyle}"
                                    Click="DeleteFromViewButton_Click"
                                    Margin="12,0,0,0"
                                    Visibility="Collapsed"/>
                            <Button x:Name="SaveNoteButton" 
                                    Content="Сохранить"
                                    Width="100"
                                    Height="38"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SaveNoteButton_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
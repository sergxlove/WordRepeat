<UserControl x:Class="WordRepeat.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WordRepeat.Views"
             mc:Ignorable="d" 
             d:DesignHeight="528" d:DesignWidth="703"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Grid.Column="2" 
                                          Focusable="false"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Border" 
                                                    Grid.ColumnSpan="2" 
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                                            <Border Grid.Column="0" 
                                                    Margin="1" 
                                                    Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="0,0,1,0"/>
                                            <Path x:Name="Arrow" 
                                                  Grid.Column="1" 
                                                  Fill="White" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  Data="M0,0 L4,4 8,0 z"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,0,30,0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            <TextBox x:Name="PART_EditableTextBox" 
                                     Style="{x:Null}" 
                                     HorizontalAlignment="Left" 
                                     VerticalAlignment="Center" 
                                     Margin="8,0,30,0"
                                     Focusable="True" 
                                     Background="Transparent" 
                                     Foreground="{TemplateBinding Foreground}"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup" 
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#FF1A1A1A" 
                                            BorderBrush="#FF444444" 
                                            BorderThickness="1"/>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#FF888888"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="true">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                            </Trigger>
                            <Trigger SourceName="Popup" Property="Popup.AllowsTransparency" Value="true">
                                <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="4"/>
                                <Setter TargetName="DropDownBorder" Property="Margin" Value="0,2,0,0"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="true">
                                <Setter Property="IsTabStop" Value="false"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2A2A2A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF2A2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="BorderBrush" Value="#FF444444"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="EditButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#FF2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#FFD32F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFC62828"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#FF4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF45A049"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#FF555555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalOverlayStyle" TargetType="Border">
            <Setter Property="Background" Value="#80000000"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="ModalWindowStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#FF444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="500"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Margin="10,10,10,20" 
                Background="#FF1E1E1E" 
                CornerRadius="8"
                BorderBrush="#FF444444"
                BorderThickness="1">

            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📝" 
                                   Foreground="White" 
                                   FontSize="20" 
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Заметки" 
                                       Foreground="White" 
                                       FontSize="20" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="Создавайте, редактируйте и управляйте своими заметками" 
                                       Foreground="#FFAAAAAA" 
                                       FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="➕ Создать заметку"
                        Width="140"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CreateNoteButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" 
                Margin="10,0,10,10" 
                Background="#FF1A1A1A" 
                CornerRadius="8"
                BorderBrush="#FF333333"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" 
                        Background="#FF222222" 
                        CornerRadius="8,8,0,0"
                        BorderBrush="#FF333333"
                        BorderThickness="0,0,0,1">

                    <StackPanel Orientation="Horizontal" 
                                Margin="15,15,15,10">
                        <TextBlock Text="📚" 
                                   Foreground="White" 
                                   FontSize="16" 
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="Мои заметки" 
                                   Foreground="White" 
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                            <TextBlock Text="Фильтр:" 
                                       Foreground="#FFAAAAAA"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="FilterCategoryComboBox" 
                                      Width="150"
                                      Height="30"
                                      Margin="10,0,0,0"
                                      Background="#FF2A2A2A"
                                      Foreground="White"
                                      BorderBrush="#FF555555"
                                      Style="{StaticResource DarkComboBoxStyle}"
                                      SelectionChanged="FilterCategoryComboBox_SelectionChanged">
                                <ComboBoxItem Content="📋 Все категории" IsSelected="True"/>
                                <ComboBoxItem Content="📘 Общее"/>
                                <ComboBoxItem Content="📖 Словарь"/>
                                <ComboBoxItem Content="🎓 Грамматика"/>
                                <ComboBoxItem Content="💡 Идеи"/>
                                <ComboBoxItem Content="✅ Задачи"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBox x:Name="SearchTextBox" 
                                 Width="200"
                                 Height="30"
                                 Background="#FF2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#FF555555"
                                 Padding="10,0"
                                 Margin="20,0,0,0"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchTextBox_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4"/>
                                                    <ScrollViewer x:Name="PART_ContentHost" 
                                                                  Margin="5,0"/>
                                                    <TextBlock Text="Поиск заметок..." 
                                                               Foreground="#FF666666"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button Content="🗘 Обновить" 
                                Width="100" Height="30"
                                Margin="20,0,0,0"
                                Background="#FF2196F3"
                                Foreground="White"
                                BorderThickness="0"
                                Click="RefreshButton_Click"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="NotesDataGrid" 
                          Grid.Row="1"
                          Margin="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          Background="Transparent"
                          Foreground="White"
                          BorderThickness="0"
                          RowBackground="#FF222222"
                          AlternatingRowBackground="#FF1E1E1E"
                          HeadersVisibility="Column"
                          HorizontalGridLinesBrush="#FF333333"
                          VerticalGridLinesBrush="#FF333333">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" 
                                            Binding="{Binding Id}"
                                            Visibility="Collapsed"/>

                        <DataGridTextColumn Header="Название" 
                                            Width="200" 
                                            Binding="{Binding Title}"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Категория" 
                                            Width="120" 
                                            Binding="{Binding Category}"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF88FF88"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Содержание" 
                                            Width="*" 
                                            Binding="{Binding Content}"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFAAAAAA"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,5"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="MaxHeight" Value="60"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Дата создания" 
                                            Width="120" 
                                            Binding="{Binding CreatedDate}"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF888888"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,5"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Действия" 
                                                Width="100"
                                                HeaderStyle="{StaticResource DataGridHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" 
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                        <Button Content="✏️" 
                                                Style="{StaticResource EditButtonStyle}"
                                                ToolTip="Редактировать"
                                                Click="EditButton_Click"
                                                Margin="0,0,5,0"/>
                                        <Button Content="🗑️" 
                                                Style="{StaticResource DeleteButtonStyle}"
                                                ToolTip="Удалить"
                                                Click="DeleteButton_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" 
                Margin="10,0,10,10" 
                Background="#FF1E1E1E" 
                CornerRadius="8"
                BorderBrush="#FF444444"
                BorderThickness="1">

            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FF2196F3" 
                                CornerRadius="5" 
                                Padding="10,5"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Всего заметок" 
                                           Foreground="White" 
                                           FontSize="11"/>
                                <TextBlock x:Name="TotalNotesCount" 
                                           Text="0" 
                                           Foreground="White" 
                                           FontSize="18"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <TextBlock Text="Страница" 
                               Foreground="#FFAAAAAA"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBlock x:Name="CurrentPageText" 
                               Text="1" 
                               Foreground="White"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="из" 
                               Foreground="#FFAAAAAA"
                               VerticalAlignment="Center"
                               Margin="10,0,10,0"/>

                    <TextBlock x:Name="TotalPagesText" 
                               Text="1" 
                               Foreground="White"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Button x:Name="FirstPageButton" 
                            Content="❮❮" 
                            Width="35" Height="25"
                            Background="#FF2A2A2A"
                            Foreground="White"
                            Margin="20,0,5,0"
                            ToolTip="Первая страница"
                            Click="FirstPageButton_Click"/>

                    <Button x:Name="PrevPageButton" 
                            Content="❮" 
                            Width="35" Height="25"
                            Background="#FF2A2A2A"
                            Foreground="White"
                            Margin="0,0,5,0"
                            ToolTip="Предыдущая страница"
                            Click="PrevPageButton_Click"/>

                    <Button x:Name="NextPageButton" 
                            Content="❯" 
                            Width="35" Height="25"
                            Background="#FF2A2A2A"
                            Foreground="White"
                            Margin="0,0,5,0"
                            ToolTip="Следующая страница"
                            Click="NextPageButton_Click"/>

                    <Button x:Name="LastPageButton" 
                            Content="❯❯" 
                            Width="35" Height="25"
                            Background="#FF2A2A2A"
                            Foreground="White"
                            ToolTip="Последняя страница"
                            Click="LastPageButton_Click"/>

                    <TextBlock Text="Показывать:" 
                               Foreground="#FFAAAAAA"
                               VerticalAlignment="Center"
                               Margin="20,0,10,0"/>

                    <ComboBox x:Name="PageSizeComboBox" 
                              Width="70" 
                              Height="25"
                              SelectedIndex="1"
                              SelectionChanged="PageSizeComboBox_SelectionChanged"
                              Style="{StaticResource DarkComboBoxStyle}">
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="25" IsSelected="True"/>
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="100"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ModalOverlay" 
                Style="{StaticResource ModalOverlayStyle}"
                Grid.RowSpan="3">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Style="{StaticResource ModalWindowStyle}">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock x:Name="ModalTitleIcon" Text="➕" 
                                       Foreground="White" 
                                       FontSize="20" 
                                       Margin="0,0,10,0"/>
                            <TextBlock x:Name="ModalTitle" Text="Создание заметки" 
                                       Foreground="White" 
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock Text="Название заметки" 
                                       Foreground="#FFAAAAAA" 
                                       FontSize="13"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="TitleTextBox" 
                                     Height="40" 
                                     Background="#FF333333"
                                     Foreground="White"
                                     BorderBrush="#FF555555"
                                     Padding="12"
                                     FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,0,15">
                            <TextBlock Text="Категория" 
                                       Foreground="#FFAAAAAA" 
                                       FontSize="13"
                                       Margin="0,0,0,8"/>
                            <ComboBox x:Name="CategoryComboBox" 
                                      Height="40"
                                      Background="#FF333333"
                                      Foreground="White"
                                      BorderBrush="#FF555555"
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <ComboBoxItem Content="📘 Общее"/>
                                <ComboBoxItem Content="📖 Словарь"/>
                                <ComboBoxItem Content="🎓 Грамматика"/>
                                <ComboBoxItem Content="💡 Идеи"/>
                                <ComboBoxItem Content="✅ Задачи"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,0,0,20">
                            <TextBlock Text="Содержание заметки" 
                                       Foreground="#FFAAAAAA" 
                                       FontSize="13"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="ContentTextBox" 
                                     Height="120" 
                                     Background="#FF333333"
                                     Foreground="White"
                                     BorderBrush="#FF555555"
                                     Padding="12"
                                     FontSize="14"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelModalButton" 
                                    Content="Отмена"
                                    Width="100"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,10,0"
                                    Click="CancelModalButton_Click"/>
                            <Button x:Name="SaveNoteButton" 
                                    Content="Сохранить"
